/* 全局字体设置 */
QWidget {
    font-family: 'Segoe UI', sans-serif;
    color: #333333;
}

/* 给容器设置背景色和圆角 */
#Container {
    background-color: #f5f7fa;
    border-radius: 12px;
}

/* 主窗口保持透明 */
#MainWindow {
    background: transparent;
}

/* --- 标题栏 --- */
#TitleBar {
    background-color: #ffffff;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #e0e0e0;
}

/* 标题栏按钮通用样式 */
.icon-btn {
    border: none;
    background: transparent;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    color: #555;
}
.icon-btn:hover {
    background-color: #f0f0f0;
}

/* 关闭按钮 */
#close-btn:hover {
    background-color: #ff4d4d;
    color: white;
}

/* 激活状态的图钉按钮 */
QPushButton[pinned="true"] {
    color: #4a90e2;
    background-color: #e6f0fa;
}

/* --- 底部输入区域：白色 + 顶部边框 --- */
#InputArea {
    background-color: #ffffff;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top: 1px solid #e0e0e0;
    padding: 10px;
}

/* 输入框 */
QTextEdit {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 8px;
    background-color: #fafafa;
    color: #333;
}

#add-btn {
    background-color: #4a90e2;
    color: white;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: bold;
    border: none;
}
#add-btn:hover {
    background-color: #357abd;
}

/* --- 待办卡片 --- */
.todo-card {
    background-color: #ffffff;
    border-radius: 8px;
    margin: 4px 10px;
    border: 1px solid #e6e6e6;
}

.date-header {
    color: #888;
    font-weight: bold;
    font-size: 13px;
    margin: 15px 0 5px 15px;
}

.time-label {
    color: #4a90e2;
    font-weight: bold;
    font-size: 11px;
}